# OMSC Website v1 - Cloudflare Pages static response headers.
# The site embeds its OWN widget pages (same-origin iframes).
# Use one security policy for the whole site: overlapping CSP/XFO rules
# combine in Cloudflare Pages and previously blocked all widget iframes.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://thumb.wikimedia.org https://image-cdn-fa.spotifycdn.com https://i.scdn.co; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; media-src 'self'; object-src 'none'; frame-ancestors 'self'; frame-src 'self'; form-action 'none'; base-uri 'self'; connect-src 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=86400
